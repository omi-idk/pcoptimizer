<Window x:Class="PCOptimizer.App.Monitoring.LiveMonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCOptimizer.App.Monitoring" Title="PCOptimizer · En vivo" Width="1050" Height="760" MinWidth="850" MinHeight="650" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="DesignBanner" Visibility="Collapsed" Text="VISTA PREVIA · DATOS ILUSTRATIVOS" Foreground="#EDB96F" Margin="0,0,0,8"/>
      <TextBlock Text="Recursos en vivo" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="CPU, memoria y sensores disponibles · no es medición de FPS ni latencia del juego" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <WrapPanel><Button Content="Iniciar monitor" Click="Start" IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButton}"/><Button Content="Parar" Click="Stop" IsEnabled="{Binding IsRunning}"/><Button Content="Exportar traza JSON" Click="Export" IsEnabled="{Binding IsIdle}"/><Button Content="Parar y medir FPS en Benchmarks" Click="Benchmarks"/></WrapPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0">
      <ComboBox ItemsSource="{Binding Series}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Sensor del monitor en vivo"/>
      <TextBlock Text="{Binding Value}" FontSize="40" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <local:LiveSensorChart Points="{Binding Points}" Height="220" AutomationProperties.Name="Últimas lecturas del sensor; puntos sin interpolación"/>
      <TextBlock Text="Eje vertical en la unidad del sensor elegido; eje horizontal en segundos QPC. Últimas 120 lecturas de la serie, sin interpolar huecos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/>
      <TextBlock Text="CPU global; no identifica el hilo del juego. Memoria física usada no prueba paginación. GPU NVIDIA depende del driver; AMD/Intel y temperatura CPU no están disponibles con este proveedor. Temperatura sola no demuestra throttling. Falta medir overhead en hardware físico." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></ScrollViewer>
  </Grid>
</Window>
