<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCOptimizer.App.Benchmarking" x:Class="PCOptimizer.App.Benchmarking.BenchmarkView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
      <Button Content="Importar CSV PresentMon" Style="{StaticResource PrimaryButton}" Click="ImportCsv"/>
      <Button Content="Guardar sesión" Click="SaveSession"/>
      <Button Content="Exportar JSON" Tag="json" Click="ExportSession"/>
      <Button Content="Exportar CSV" Tag="csv" Click="ExportSession"/>
    </WrapPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,18">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CAPTURA MANUAL · ETW" Style="{StaticResource SectionLabel}"/>
            <TextBlock Text="{Binding Capability}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/>
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button Content="Obtener PresentMon oficial" Click="OpenPresentMon"/>
              <Button Content="Seleccionar auxiliar" Click="SelectExecutable"/>
              <Button Content="Actualizar procesos" Click="RefreshProcesses"/>
            </WrapPanel>
            <Grid Margin="0,8,0,0" IsEnabled="{Binding IsIdle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" ToolTip="Proceso en ejecución que se medirá"/>
              <TextBox Grid.Column="1" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Tag="Segundos" ToolTip="Duración: 5–600 segundos" Margin="8,0"/>
              <Button Grid.Column="2" Content="Iniciar captura" Click="StartCapture"/>
            </Grid>
          </StackPanel>
        </Border>
        <ComboBox ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" Margin="0,14,0,12" IsEnabled="{Binding IsIdle}" ToolTip="Elige aplicación, PID y swapchain; no se mezclan streams"/>
        <UniformGrid Columns="3" Margin="0,0,-10,12">
          <Border Style="{StaticResource Card}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="FPS PRESENTADOS · MEDIA" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding Average}" FontSize="27" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="1% LOW · COLA LENTA" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding Low1}" FontSize="27" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="0.1% LOW · COLA LENTA" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding Low01}" FontSize="27" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Percentiles}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="FRAMETIMES DE PRESENTACIÓN" Style="{StaticResource SectionLabel}"/>
            <TextBlock Text="Eje temporal: suma de intervalos válidos. Máximo por columna para conservar spikes; no es el reloj ETW." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <local:FrameChart Frames="{Binding Frames}" Height="210"/>
            <TextBlock Text="DISTRIBUCIÓN DE FPS INSTANTÁNEOS · 20 INTERVALOS" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
            <local:FrameChart Frames="{Binding Frames}" Histogram="True" Height="170"/>
          </StackPanel>
        </Border>
        <Expander Header="Contexto reproducible · completa antes de guardar" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
          <StackPanel Margin="12">
            <TextBlock Text="Los datos introducidos son declaraciones del usuario. Una sesión guardada conserva su contexto original." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            <TextBox Text="{Binding Hardware, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Hardware: CPU, GPU, RAM, pantalla" Margin="0,10,0,6"/>
            <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Juego y versión" Margin="0,0,0,6"/>
            <TextBox Text="{Binding DriverVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Versión de drivers" Margin="0,0,0,6"/>
            <TextBox Text="{Binding WindowsVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Windows y build" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Settings, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Resolución, Hz, VSync, límite FPS, DLSS/FG, Reflex y calidad" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" IsReadOnly="{Binding ContextReadOnly}" Tag="Escenario, ruta, duración, calentamiento y variable A/B"/>
          </StackPanel>
        </Expander>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="HISTORIAL Y COMPARACIÓN" Style="{StaticResource SectionLabel}"/>
            <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
              <Button Content="Actualizar historial" Click="RefreshHistory"/>
              <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Width="260" Margin="0,0,8,0"/>
              <Button Content="Cargar" Click="LoadSession"/>
              <Button Content="Fijar referencia A" Click="SetBaseline"/>
              <Button Content="Comparar B con A" Click="CompareSessions"/>
            </WrapPanel>
            <TextBlock Text="{Binding RepetitionCounts}" Margin="0,12,0,4"/>
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button Content="Añadir sesión a A" Tag="A" Click="AddRepetition"/>
              <Button Content="Añadir sesión a B" Tag="B" Click="AddRepetition"/>
              <Button Content="Analizar repeticiones" Click="CompareRepetitions"/>
              <Button Content="Vaciar grupos" Click="ClearRepetitions"/>
            </WrapPanel>
            <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Detener / cancelar" IsEnabled="{Binding IsBusy}" Click="Cancel" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
