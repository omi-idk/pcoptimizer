<Window x:Class="PCOptimizer.App.SelectionReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revisar cambios" Width="820" Height="740" MinWidth="600" MinHeight="480" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="CONFIRMACIÓN" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" /></StackPanel>
  <Border Grid.Row="1" BorderBrush="#4E4737" BorderThickness="1" Background="#27251F" CornerRadius="6" Padding="15" Margin="0,0,0,18"><TextBlock x:Name="Notice" Foreground="#D9CAAB" FontSize="12" /></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Selection"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,7,0,0" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12" /><TextBlock Text="{Binding Notes}" Foreground="#DDC298" Margin="0,12,0,0" FontSize="12" />
  </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Cancelar no aplica cambios." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancelar" IsCancel="True" Margin="0,0,12,0" /><Button Content="Confirmar selección" Click="Accept" Style="{StaticResource PrimaryButton}" /></StackPanel></Grid>
 </Grid>
</Window>
