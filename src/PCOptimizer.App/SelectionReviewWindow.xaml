<Window x:Class="PCOptimizer.App.SelectionReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Revisar selección" Width="740" Height="680" MinWidth="560" MinHeight="440"
 Background="#0D0F15" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14" />
  <TextBlock x:Name="Notice" Grid.Row="1" Foreground="#A3A3B7" Margin="0,0,0,16" />
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="Selection">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="#181B25" CornerRadius="8" Padding="16" Margin="0,0,0,10">
       <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" />
        <TextBlock Text="{Binding SourceLabel}" Foreground="#69E3BD" Margin="0,6,0,0" />
        <TextBlock Text="{Binding Id}" Foreground="#A3A3B7" FontSize="11" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Website}" Foreground="#A3A3B7" FontSize="11" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Detail}" Foreground="#A3A3B7" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Notes}" Foreground="#F0CB83" Margin="0,8,0,0" />
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Cancelar" IsCancel="True" Margin="0,0,12,0" />
   <Button Content="Continuar con esta selección" Click="Accept" Background="#28775E" />
  </StackPanel>
 </Grid>
</Window>
